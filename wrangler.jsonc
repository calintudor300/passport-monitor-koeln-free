{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passport-monitor-koeln-free",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {"binding": "DATA", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE"}
  ]
}
